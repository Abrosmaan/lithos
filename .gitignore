# Секреты — только на VPS и локально, никогда в git
.env
.env.*
!.env.example
*.pem
*.key

# Приватные заметки по инфре (IP, id аккаунтов, чужие проекты) — не для публичного репо
.private/

# Node / pnpm
node_modules/
dist/
build/
.expo/
.turbo/
*.tsbuildinfo
coverage/

# Expo / EAS
ios/
android/
*.jks
*.p8
*.p12
