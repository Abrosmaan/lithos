{
  "name": "lithos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "eval": "pnpm --filter worker eval",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:migrate:status": "node scripts/db-migrate.mjs --status"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "dotenv": "^16.4.0",
    "eslint": "^9.0.0",
    "globals": "^17.12.0",
    "pg": "^8.13.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
