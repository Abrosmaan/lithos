# Lithos — шаблон. Реальные значения в .env (в git не попадает).

# ---- Supabase (общий проект, схема lithos) ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=                  # только воркер
SUPABASE_ANON_KEY=                     # клиент
SUPABASE_DB_URL=                       # direct, IPv6 (VPS)
SUPABASE_DB_POOLER_URL=                # session pooler, IPv4 (мак, миграции)
DB_SCHEMA=lithos

# ---- Клиент (в бандл попадают только EXPO_PUBLIC_*) ----
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---- Модели ----
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
STAGE_GATE=google:gemini-3.1-flash-lite      # переопределяется после T2.4
STAGE_MAIN=anthropic:claude-sonnet-5
STAGE_ESCALATION=anthropic:claude-opus-5
FALLBACK_PROVIDER=google

# ---- Лимиты ----
DAILY_BUDGET_USD=50
MAX_SCANS_PER_DAY=10
MACROSTRAT_BASE=https://macrostrat.org/api/v2

# ---- Прочее ----
LOG_LEVEL=info
